<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- AD0001 = an analyzer crashed. The ASP.NET Core RouteHandlerAnalyzer throws NullReferenceException on route
         handlers whose parameter is a generic type parameter (PaymentEndpoints.Handlers<TService>). The code is
         valid; only the analyzer fails, and TreatWarningsAsErrors would turn its crash into a build error. -->
    <NoWarn>$(NoWarn);AD0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MassTransit.MongoDb" Version="8.5.12" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.12" />
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
    <PackageReference Include="MongoDB.EntityFrameworkCore" Version="10.0.4" />
  </ItemGroup>
</Project>
